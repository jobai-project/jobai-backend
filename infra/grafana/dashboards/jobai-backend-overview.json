{
  "title": "jobai-backend Overview",
  "uid": "jobai-backend-overview",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "10s",
  "tags": ["jobai", "spring-boot"],
  "panels": [
    { "id": 100, "type": "row", "title": "Overview", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 1, "type": "stat", "title": "Service Up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"jobai-backend-local\"}", "legendFormat": "up" }],
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
      ] }, "overrides": [] }
    },
    {
      "id": 2, "type": "stat", "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "process_uptime_seconds{job=\"jobai-backend-local\"}", "legendFormat": "uptime" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "HTTP Request Rate",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=\"jobai-backend-local\"}[5m]))", "legendFormat": "req/s" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "5xx Error Rate",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 * sum(rate(http_server_requests_seconds_count{job=\"jobai-backend-local\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"jobai-backend-local\"}[5m]))", "legendFormat": "error %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 }
      ] } }, "overrides": [] }
    },

    { "id": 101, "type": "row", "title": "JVM", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 } },
    {
      "id": 10, "type": "timeseries", "title": "Heap Memory (used / max)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{job=\"jobai-backend-local\",area=\"heap\"})", "legendFormat": "used" },
        { "expr": "sum(jvm_memory_max_bytes{job=\"jobai-backend-local\",area=\"heap\"})", "legendFormat": "max" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 11, "type": "timeseries", "title": "GC Pause (avg)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_sum{job=\"jobai-backend-local\"}[5m]) / rate(jvm_gc_pause_seconds_count{job=\"jobai-backend-local\"}[5m])", "legendFormat": "{{action}} / {{cause}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 12, "type": "timeseries", "title": "Live Threads",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "jvm_threads_live_threads{job=\"jobai-backend-local\"}", "legendFormat": "live threads" }],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 13, "type": "timeseries", "title": "CPU Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "process_cpu_usage{job=\"jobai-backend-local\"}", "legendFormat": "process cpu" },
        { "expr": "system_cpu_usage{job=\"jobai-backend-local\"}", "legendFormat": "system cpu" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] }
    },

    { "id": 102, "type": "row", "title": "API Performance", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 } },
    {
      "id": 20, "type": "timeseries", "title": "Response Time Percentiles (Overall)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=\"jobai-backend-local\"}[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"jobai-backend-local\"}[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"jobai-backend-local\"}[5m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 21, "type": "timeseries", "title": "p99 Latency by URI (top 10)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "topk(10, histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"jobai-backend-local\"}[5m])) by (uri, le)))", "legendFormat": "{{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 22, "type": "timeseries", "title": "Request Rate by URI (top 10)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{job=\"jobai-backend-local\"}[5m])))", "legendFormat": "{{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 23, "type": "timeseries", "title": "Error Rate by URI",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{job=\"jobai-backend-local\",status=~\"5..\"}[5m])))", "legendFormat": "{{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },

    { "id": 103, "type": "row", "title": "Database", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 } },
    {
      "id": 30, "type": "timeseries", "title": "HikariCP Connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "hikaricp_connections_active{job=\"jobai-backend-local\"}", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle{job=\"jobai-backend-local\"}", "legendFormat": "idle" },
        { "expr": "hikaricp_connections_pending{job=\"jobai-backend-local\"}", "legendFormat": "pending" },
        { "expr": "hikaricp_connections_max{job=\"jobai-backend-local\"}", "legendFormat": "max" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 31, "type": "timeseries", "title": "HikariCP Connection Acquire Time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "hikaricp_connections_acquire_seconds{job=\"jobai-backend-local\",quantile=\"0.95\"}", "legendFormat": "p95" },
        { "expr": "hikaricp_connections_acquire_seconds{job=\"jobai-backend-local\",quantile=\"0.99\"}", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },

    { "id": 104, "type": "row", "title": "Kafka", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 } },
    {
      "id": 40, "type": "timeseries", "title": "Consumer Lag by Topic",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (topic) (kafka_consumer_records_lag{job=\"jobai-backend-local\"})", "legendFormat": "{{topic}}" }],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 41, "type": "timeseries", "title": "Consumer Throughput (records/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (topic) (rate(kafka_consumer_records_consumed_total{job=\"jobai-backend-local\"}[5m]))", "legendFormat": "{{topic}}" }],
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] }
    },

    { "id": 105, "type": "row", "title": "Business", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 } },
    {
      "id": 50, "type": "timeseries", "title": "AI Scoring Duration",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(ai_scoring_duration_seconds_sum{job=\"jobai-backend-local\"}[5m]) / rate(ai_scoring_duration_seconds_count{job=\"jobai-backend-local\"}[5m])", "legendFormat": "avg {{type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 51, "type": "timeseries", "title": "AI Scoring Failures",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(ai_scoring_failures_total{job=\"jobai-backend-local\"}[5m])", "legendFormat": "failures/s" }],
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] }
    },
    {
      "id": 52, "type": "timeseries", "title": "Crawl Collect Count",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "increase(crawl_collect_success_total{job=\"jobai-backend-local\"}[1h])", "legendFormat": "success" },
        { "expr": "increase(crawl_collect_failure_total{job=\"jobai-backend-local\"}[1h])", "legendFormat": "failure" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
